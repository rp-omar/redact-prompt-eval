{
  "name": "redact-prompt-eval",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:redact": "vite build --outDir dist-redact",
    "build:react-dom": "RENDERER=react-dom vite build --outDir dist-react-dom",
    "build:both": "bun run build:redact && bun run build:react-dom",
    "budget": "node scripts/budget.mjs",
    "lint": "oxlint src mock scripts tests",
    "bench": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/bench.pw.ts",
    "react-doctor": "react-doctor",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium firefox webkit",
    "test:flows": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/flows.pw.ts",
    "report": "node scripts/report.mjs",
    "doctor": "react-doctor . -y --no-supply-chain --no-score"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/redact": "0.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@stylexjs/unplugin": "0.19.2",
    "@tanstack/router-plugin": "1.169.0",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun": "1.4.5",
    "oxlint": "1.81.0",
    "react-doctor": "0.9.23",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
